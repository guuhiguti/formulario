# URL de conexão do banco PostgreSQL (Neon, Supabase, etc.)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Senha única para acessar a área /admin
ADMIN_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão do admin (string aleatória longa)
SESSION_SECRET="gere-um-valor-aleatorio-longo-aqui"
