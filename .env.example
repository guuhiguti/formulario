# Connection strings do banco PostgreSQL (Vercel Postgres / Neon).
# Se você instalou a integração "Postgres" da Vercel, essas variáveis já são
# criadas automaticamente (rode `vercel env pull .env.local` para buscá-las).
STORAGE_POSTGRES_PRISMA_URL="postgresql://usuario:senha@host/banco?sslmode=require"
STORAGE_POSTGRES_URL_NON_POOLING="postgresql://usuario:senha@host/banco?sslmode=require"

# Hash bcrypt da senha única de acesso à área /admin.
# Gere com: npm run hash-password -- "sua-senha"
ADMIN_PASSWORD_HASH="$2a$12$exemplo-gerado-pelo-comando-acima"

# Segredo usado para assinar o cookie de sessão do admin (string aleatória longa)
SESSION_SECRET="gere-um-valor-aleatorio-longo-aqui"
