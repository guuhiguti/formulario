generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("STORAGE_POSTGRES_PRISMA_URL")
  directUrl = env("STORAGE_POSTGRES_URL_NON_POOLING")
}

enum HowFoundOut {
  REDES_SOCIAIS
  INDICACAO_VOLUNTARIO
  INDICACAO_AMIGOS_FAMILIA
  OUTRO
}

enum InterestArea {
  MIDIAS_SOCIAIS_MARKETING
  FOTOS_VIDEOS
  RECREACAO_OFICINAS
  CULINARIA_ALIMENTACAO
  ORGANIZACAO_LOGISTICA
}

enum VolunteerStatus {
  NOVO
  CONTATADO
  ATIVO
  INATIVO
}

model Volunteer {
  id           String   @id @default(cuid())

  fullName     String
  age          Int
  birthDate    DateTime
  neighborhood String
  whatsapp     String
  email        String
  instagram    String

  howFoundOut       HowFoundOut
  referralName      String?
  otherSourceDetail String?

  expectations String

  hasExperience    Boolean
  experienceDetail String?

  interestAreas InterestArea[]

  lgpdConsent Boolean @default(false)

  status    VolunteerStatus @default(NOVO)
  createdAt DateTime        @default(now())

  @@index([createdAt])
}
